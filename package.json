{
  "name": "sarapresa-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"lib/**/*.test.tsx\"",
    "email:dev": "node --env-file-if-exists=.env.local ./node_modules/react-email/dist/cli/index.mjs dev --dir emails --port 3001",
    "newsletter:draft": "tsx --env-file-if-exists=.env.local scripts/newsletter-draft.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "cn": "^0.2.6",
    "framer-motion": "^13.2.0",
    "lenis": "^1.3.26",
    "next": "^16.3.4",
    "next-intl": "^4.14.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.11.1",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
